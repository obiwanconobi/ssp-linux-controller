    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
